# The Dify web console root. Both https://cloud.dify.ai and a URL ending in /apps are accepted.
DIFY_BASE_URL=https://cloud.dify.ai

# Optional persistent browser profile. Defaults to ~/.dify-workflow-mcp/browser-profile.
# DIFY_PROFILE_DIR=/absolute/path/to/browser-profile

# Optional browser executable when automatic detection does not find Chrome, Edge, or Chromium.
# CHROME_PATH=/absolute/path/to/chrome

# Set true only after the profile is authenticated and no interactive login is needed.
DIFY_HEADLESS=false
